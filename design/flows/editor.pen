        },
        {
          "type": "text",
          "id": "t08gYb",
          "name": "1 Purpose body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Draw and edit a diagram with others in real time: the Excalidraw canvas plus the Drawhaus shell around it (icon bar, drawer panels, floating status).",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "hujJc",
          "name": "2 Entry points",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "2 Entry points",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "p7ozBm",
          "name": "2 Entry points body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "/board/:id from the dashboard card or after creating a diagram. Guests arrive through /share/:token (Share flow). The logo button leaves directly, and asks first only while changes are pending or saving; the Settings drawer's Dashboard button always asks (the dialog drawn here).",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "n0WtUQ",
          "name": "3 Screens",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "3 Screens",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "hrkHS",
          "name": "3 Screens body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Editing (owner/editor) · Share panel open · Reconnecting · View only (viewer) · Leave dialog. Base frame 1280×800, light theme.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "zTfTJ",
          "name": "4 Business rules",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "4 Business rules",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "hqshE",
          "name": "4 Business rules body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Create and history tools (Import from Code, Save as Template, Version History) need edit permission; Export, Comments and Share are always there. The status pill and the raise-hand control show only for editors. The connection badge is hidden while connected. Saved state follows idle/pending/saving/saved/error.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "T54wl",
          "name": "5 Copy source",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "5 Copy source",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "P2uEWZ",
          "name": "5 Copy source body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "components/BoardEditor.tsx, BoardSidebar.tsx, board-sidebar/SharePanel.tsx and SidebarButton.tsx, ConnectionBadge.tsx, CollaborationBadge.tsx, lib/save-state.ts. Spanish strings (“Mano”, tooltips) are the code's, kept as is (D11).",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "nfQ8a",
          "name": "6 States not drawn",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "6 States not drawn",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "SWYrl",
          "name": "6 States not drawn body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The canvas content, Excalidraw's own toolbar and menus (third-party), Comments panel, Export, Import from Code, Save as Template, Version History and Settings drawers, offline-recovery dialog, following banner, saving and error pills (label swaps), dark theme. Icon-bar icons are feather equivalents of the app's custom SVGs. Pills use flow-local pill-* tokens that mirror the raw Tailwind colours the code uses (D8, D15).",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "vZSPg",
          "name": "7 Open findings",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "7 Open findings",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "mhE2Y",
          "name": "7 Open findings body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "D11 Spanish strings in an English UI · D13 Excalidraw never gets the theme · D15 save pill uses its own palette · D16 10 px pills · D19 the share panel serves a stale cached link · D20 share failures are silent · D25 seven hand-rolled overlays besides ConfirmDialog, this one included.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "ZXBUA",
