      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "qr08O",
          "name": "Title",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Comments — brief",
          "fontFamily": "$font-heading",
          "fontSize": 24,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "uEyy2",
          "name": "1 Purpose",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "1 Purpose",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "zlsOZ",
          "name": "1 Purpose body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Discuss a diagram inside the board: threaded comments anchored to an element or general, with replies, likes, resolve and delete, plus count badges on the canvas.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "YVui6",
          "name": "2 Entry points",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "2 Entry points",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "fJUVg",
          "name": "2 Entry points body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The Comments button in the editor's icon bar (also a keyboard shortcut) toggles a 320 px panel on the right. Viewers can comment by design: the socket handlers gate on room membership, not canEdit.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "o6OlNh",
          "name": "3 Screens",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "3 Screens",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "hDRl0",
          "name": "3 Screens body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Open (element selected, indicators on) · Empty · Resolved tab · Reply form open. Base frame 1280×800, light theme, canvas shrinks to 904 px.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "xqz2h",
          "name": "4 Business rules",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "4 Business rules",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "T4lHU7",
          "name": "4 Business rules body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Threads load per scene; a thread on a deleted element shows “Element removed”. Posting is rate limited to 10 per window and bodies are 1–5000 characters. Likes go over REST, everything else over the socket with a REST fallback offline. Resolved threads render at 60% opacity and drop out of the canvas count.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "IvbPd",
          "name": "5 Copy source",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "5 Copy source",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "A3dSM",
          "name": "5 Copy source body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "components/CommentsPanel.tsx, CommentIndicators.tsx, lib/hooks/useComments.ts, lib/comments.ts. Comment bodies and names in the drawing are sample data, not copy from the code.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "u83DE",
          "name": "6 States not drawn",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "6 States not drawn",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "MGzdr",
          "name": "6 States not drawn body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Dark theme, a failed post or load (a toast and a LoadError with Try again, as in the settings flow), the delete confirmation (the shared ConfirmDialog), the viewer-only panel (identical).",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "U3lhHG",
          "name": "7 Open findings",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "7 Open findings",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "K0ottK",
          "name": "7 Open findings body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "D41–D45 are fixed in code and redrawn: failures show a retry or a toast, delete asks first, the dead Filter, Mention, Emoji and Attach buttons are gone, the tabs and fields are named, and resolved threads are muted with a token.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "PETMQ",
          "name": "8 History",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "8 History",
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "hMfd6",
          "name": "8 History body",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
