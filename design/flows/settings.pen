          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Cannot change role, status or delete yourself. Admins cannot be deleted. Invite works with public registration off. Backups: cron plus retention 1–365 days. Secrets need ENCRYPTION_KEY; webhooks need at least one event and a URL. Secret sources: DB, ENV or not set.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
