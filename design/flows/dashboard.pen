          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "D7 toolbar buttons are hand-rolled, disabled has no style · D8 DiagramCard uses raw palette colours and fails AA on Delete · D9 hover-only controls unreachable by keyboard · D10 heading scale ad hoc · D16 micro type 9–12px · D18 “Invalid Date” fallback.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 14
