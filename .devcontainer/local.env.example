# Copy to .devcontainer/local.env (gitignored) to run Kamal against your server
# from the devcontainer, then rebuild the container. See .devcontainer/README.md.
#
# Only what cannot be derived. GITHUB_REPOSITORY, GITHUB_REPOSITORY_OWNER and
# GITHUB_ACTOR come from the host through initialize.sh; a value set here
# overrides it. Never GH_TOKEN: gh is logged in from the host.
#
# No production secrets: never DATABASE_URL, SESSION_SECRET, ENCRYPTION_KEY,
# POSTGRES_PASSWORD, the OAuth client secrets or any API token. A compromised
# container would hand over production. Deploys run in GitHub Actions.

HOST_IP=
APP_HOST=
API_HOST=
