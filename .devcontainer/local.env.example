# Copy to .devcontainer/local.env (gitignored) to run read-only Kamal commands
# such as `kamal config -c config/deploy.backend.yml` from inside the devcontainer.
#
# Non-secret values only. Never add DATABASE_URL, SESSION_SECRET, ENCRYPTION_KEY,
# POSTGRES_PASSWORD, the OAuth client secrets or any API token: a compromised
# container would hand over production. Deploys run in CI.
#
# The registry account and image names are literals in config/deploy.*.yml, so
# they are not listed here.

# VPS the deploy targets — the production GitHub Environment variable HOST_IP.
HOST_IP=
